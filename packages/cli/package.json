{
  "name": "plate-pool",
  "version": "0.0.0",
  "private": true,
  "description": "Plate loading calculator for one home gym",
  "type": "module",
  "bin": {
    "plate-pool": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('../../inventory/inventory.json', 'dist/inventory.json')\"",
    "test": "tsc -p tsconfig.json && vitest run"
  },
  "dependencies": {
    "@plate-pool/core": "0.0.0"
  }
}
