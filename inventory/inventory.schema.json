{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/joeuk89/plate-pool/main/inventory/inventory.schema.json",
  "title": "plate-pool inventory, format 1",
  "description": "Every plate type, plate, piece of locking hardware and implement in one gym. Equipment only: no order numbers, prices, dates or addresses.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "name", "lengthUnit", "plateTypes", "plates", "hardware", "implements"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "description": "The version of this file's shape.", "const": 1 },
    "name": { "description": "The kit's name.", "type": "string" },
    "lengthUnit": { "description": "The unit of every length in the file.", "enum": ["mm", "in"] },
    "plateTypes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/plateType" } },
    "plates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/plate" } },
    "hardware": { "type": "array", "items": { "$ref": "#/$defs/hardware" } },
    "implements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/implement" } }
  },
  "$defs": {
    "id": {
      "description": "Lower-case letters, digits, dots and hyphens.",
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "implementId": {
      "description": "Lower-case letters, digits and hyphens. Not a word the links use.",
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "not": { "enum": ["view", "uneven", "kit", "inventory", "single", "pair", "hardware"] }
    },
    "unit": { "enum": ["lb", "kg"] },
    "status": {
      "description": "verified: the manufacturer or distributor states it. owner: the owner confirmed it on the equipment. unverified: no reliable source or measurement confirms it.",
      "enum": ["verified", "owner", "unverified"]
    },
    "value": {
      "description": "A listed value, an optional measured value that overrides it, and a status.",
      "type": "object",
      "additionalProperties": false,
      "required": ["listed", "status"],
      "properties": {
        "listed": { "type": "number", "minimum": 0 },
        "measured": { "type": "number", "minimum": 0 },
        "status": { "$ref": "#/$defs/status" },
        "note": { "type": "string" }
      }
    },
    "length": { "type": "number", "exclusiveMinimum": 0 },
    "count": { "type": "integer", "minimum": 0 },
    "plateType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "unit", "bore"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "unit": { "$ref": "#/$defs/unit" },
        "bore": {
          "description": "Draws the plate's hole or pocket. Fit is stated by each implement's accepts.",
          "enum": ["olympic", "standard", "quick-lock", "block"]
        }
      }
    },
    "plate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "count", "weight", "shape"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "description": "A display name. Plates are otherwise named by weight.", "type": "string" },
        "type": { "$ref": "#/$defs/id" },
        "count": { "$ref": "#/$defs/count" },
        "countStatus": { "$ref": "#/$defs/status" },
        "weight": { "$ref": "#/$defs/value" },
        "stackLength": {
          "description": "The length the plate adds to a stack. Required unless the plate type's bore is block.",
          "$ref": "#/$defs/value"
        },
        "diameter": { "$ref": "#/$defs/length" },
        "colour": { "description": "A CSS colour.", "type": "string" },
        "shape": { "enum": ["square", "round", "hexagonal", "twelve-sided", "block"] }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "count", "unit", "weight"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "kind": { "enum": ["screw", "collar", "pin"] },
        "count": { "$ref": "#/$defs/count" },
        "unit": { "$ref": "#/$defs/unit" },
        "weight": { "$ref": "#/$defs/value" },
        "capacity": { "description": "The longest stack the item holds.", "$ref": "#/$defs/length" },
        "minStack": { "description": "The shortest stack the item locks on.", "$ref": "#/$defs/value" },
        "width": { "description": "The length the item takes on a position.", "$ref": "#/$defs/length" },
        "note": { "description": "Shown whenever the item is used as a fallback.", "type": "string" }
      }
    },
    "implement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "count", "unit", "base", "accepts"],
      "properties": {
        "id": { "$ref": "#/$defs/implementId" },
        "name": { "type": "string" },
        "kind": { "enum": ["bar", "handle", "stack", "vest"] },
        "count": { "type": "integer", "minimum": 1 },
        "unit": { "$ref": "#/$defs/unit" },
        "base": { "description": "The implement's weight with no plates and no locking hardware.", "$ref": "#/$defs/value" },
        "accepts": {
          "description": "The plate types this implement takes.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" }
        },
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["options", "perPosition"],
          "properties": {
            "options": {
              "description": "Hardware ids this implement takes, in the order they are tried, or \"none\".",
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/id" }
            },
            "default": { "$ref": "#/$defs/id" },
            "perPosition": { "type": "integer", "minimum": 1 }
          }
        },
        "positionLength": { "description": "The length of one position for plates and hardware together.", "$ref": "#/$defs/value" },
        "unevenAllowance": { "description": "The most a handle's two ends may differ by, in its unit.", "type": "number", "minimum": 0 },
        "unevenAllowanceRelaxed": {
          "description": "The allowance when every plate weighing at most unevenAllowance is in use elsewhere.",
          "type": "number",
          "minimum": 0
        },
        "maxPlateDiameter": { "$ref": "#/$defs/length" },
        "maxPerPosition": {
          "description": "Plate id to the most of that plate one position holds.",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/count" }
        },
        "maxPlateWeight": { "description": "The most plate weight the implement takes, in its unit.", "type": "number", "exclusiveMinimum": 0 },
        "maxTotal": { "description": "The heaviest total the implement reaches, in its unit.", "type": "number", "exclusiveMinimum": 0 },
        "note": { "description": "A fixed sentence on every result.", "type": "string" },
        "baseIncludesHardware": { "description": "base already includes the hardware's weight.", "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "handle" } } },
          "then": { "required": ["unevenAllowance"] },
          "else": { "properties": { "unevenAllowance": false, "unevenAllowanceRelaxed": false } }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "vest" } } },
          "then": { "properties": { "hardware": false, "positionLength": false, "maxPlateDiameter": false, "baseIncludesHardware": false } }
        }
      ]
    }
  }
}
